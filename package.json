{
  "name": "adyen-web-inspector",
  "version": "1.5.0",
  "description": "Chrome Extension that analyses adyen-web (Drop-in / Components) implementations",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "clean": "rm -rf dist coverage test-results playwright-report tsconfig.tsbuildinfo",
    "icons:generate": "./scripts/generate-icons.sh",
    "package:chrome": "./scripts/package-chrome.sh",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm lint:code && pnpm lint:gha && pnpm lint:md",
    "lint:code": "eslint --max-warnings=0 .",
    "lint:code:fix": "eslint . --fix",
    "lint:gha": "node ./scripts/check-gha-pinned-actions.mjs",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#dist\" \"#coverage\" \"#playwright-report\" \"#test-results\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\" \"#node_modules\" \"#dist\" \"#coverage\" \"#playwright-report\" \"#test-results\"",
    "lint:fix": "pnpm lint:code:fix && pnpm lint:md:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "pnpm build && playwright test",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "knip": "knip && knip --production",
    "validate": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm depcruise && pnpm knip && pnpm test:coverage && pnpm test:integration",
    "prepare": "husky"
  },
  "dependencies": {
    "preact": "^11.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.3.7",
    "@vitest/coverage-v8": "^5.1.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-regexp": "^3.3.3",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "gts": "^7.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.24.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0 --no-warn-ignored --fix",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ],
    "**/*.md": [
      "markdownlint-cli2 --fix"
    ],
    "*.{css,html,json,yaml,yml}": [
      "prettier --write"
    ],
    ".github/{workflows/*,actions/**/action}.{yml,yaml}": [
      "node ./scripts/check-gha-pinned-actions.mjs"
    ]
  }
}
